# =============================================================================
# Manus Glove USB Dongle udev Rule
# =============================================================================
# Grants non-root users access to Manus USB dongles, eliminating the need
# for sudo when running manus_data_publisher.
#
# Covers all Manus products by matching vendor ID 3325:
#   - Quantum Metaglove dongle (3325:00ca)
#   - Pro dongle (3325:0049)
#   - Future Manus products
#
# Install:
#   sudo cp 99-manus-libusb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Verify:
#   lsusb -d 3325:       (should list Manus dongle)
#   ls -l /dev/bus/usb/   (device should show 0666 permissions after replug)
# =============================================================================

SUBSYSTEM=="usb", ATTR{idVendor}=="3325", MODE="0666"

# Manus Wireless Transceiver (Nordic Semiconductor nRF, vendor 1915:83fd)
# BLE bridge between glove dongles and gloves — SDK reads skeleton stream
# through the receiver's hidraw node, so both the USB side and the hidraw
# side need 0666 or the gloves enumerate fine but no skeleton data flows.
SUBSYSTEM=="usb", ATTR{idVendor}=="1915", ATTR{idProduct}=="83fd", MODE="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="1915", ATTRS{idProduct}=="83fd", MODE="0666"
