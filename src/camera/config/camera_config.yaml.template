# =============================================================================
# Camera Configuration File
# =============================================================================
# Supports three camera positions: head, left_wrist, right_wrist
# Head: HBVCAM-F2439GS-2 V11 (AR0234 global shutter, USB stereo, OpenCV UVC)
# Wrist: RealSense D405 (global shutter, bound by serial number)
#        Get the serial: rs-enumerate-devices | grep "Serial Number"
#
# Device paths are fixed by udev rules, unaffected by plug/unplug order:
#   /dev/stereo_camera   ← HBVCAM stereo camera
#   /dev/cam_left_wrist  ← Left wrist RealSense
#   /dev/cam_right_wrist ← Right wrist RealSense
#
# First-time setup: bash src/camera/setup_cameras.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Global Settings
# -----------------------------------------------------------------------------
global:
  # Camera startup interval delay to avoid USB bandwidth issues (seconds)
  startup_delay: 5.0
  # Enable inter-camera sync for RealSense (master-slave mode)
  # D435i/D455 support hardware sync
  enable_sync: false

# -----------------------------------------------------------------------------
# Camera configuration
# -----------------------------------------------------------------------------
cameras:
  # -------------------------
  # Head camera (HBVCAM-F2439GS-2 V11, AR0234 global shutter, OpenCV UVC)
  # Sensor: AR0234CS (1/2.6" CMOS, global shutter, 3.0µm pixel)
  # Lens: 2.96mm (125° H-FOV) / Baseline: 60mm
  # Runtime parameters (H.264/ROS2 topics) see: config/stereo_head/stereo_head_config.yaml
  # Alternative: ZED Mini (type: "usb", 2560x720@60, 85° H-FOV, rolling shutter)
  # -------------------------
  head:
    enabled: true
    # Camera type: usb (UVC stereo), d405 (RealSense wrist)
    type: "usb"

    # USB camera parameters (HBVCAM via udev symlink)
    video_device: "/dev/stereo_camera"
    pixel_format: "mjpeg2rgb"    # mjpeg2rgb, yuyv2rgb, raw_mjpeg, nv12
    io_method: "mmap"            # mmap, read, userptr

    # General parameters (HBVCAM side-by-side: 2560x720@60fps, H-FOV 125°)
    resolution:
      width: 2560
      height: 720
      fps: 60

    # Topic names
    camera_name: "cam_head"

    # Stream settings (RealSense only, ignored in USB mode)
    streams:
      enable_color: true
      enable_depth: false
      align_depth: false
      enable_pointcloud: false
      enable_gyro: false
      enable_accel: false

    # TF coordinate frame configuration
    tf:
      parent_frame: "base_link"
      child_frame: "cam_head_link"
      translation: [0.0, 0.0, 0.5]    # [x, y, z] meters
      rotation: [0.0, 0.3, 0.0]       # [roll, pitch, yaw] radians

  # -------------------------
  # Left wrist camera (RealSense D405, global shutter)
  # -------------------------
  left_wrist:
    enabled: true
    type: "d405"

    # RealSense parameters (bound by serial; update when swapping cameras).
    # Find the serial: rs-enumerate-devices | grep "Serial Number"
    serial_number: "YOUR_LEFT_WRIST_CAM_SERIAL"

    # USB camera parameters (udev symlink, no need to worry about /dev/videoN)
    video_device: "/dev/cam_left_wrist"
    pixel_format: "mjpeg2rgb"
    io_method: "mmap"

    # General parameters
    resolution:
      width: 848
      height: 480
      fps: 30

    camera_name: "cam_left_wrist"

    streams:
      enable_color: true
      enable_depth: false
      align_depth: false
      enable_pointcloud: false
      enable_gyro: false
      enable_accel: false

    tf:
      parent_frame: "left_wrist_link"
      child_frame: "cam_left_wrist_link"
      translation: [0.0, 0.0, 0.0]
      rotation: [0.0, 0.0, 0.0]

  # -------------------------
  # Right wrist camera (RealSense D405, global shutter)
  # -------------------------
  right_wrist:
    enabled: true
    type: "d405"

    # RealSense parameters (bound by serial; update when swapping cameras).
    # Find the serial: rs-enumerate-devices | grep "Serial Number"
    serial_number: "YOUR_RIGHT_WRIST_CAM_SERIAL"

    # USB camera parameters
    video_device: "/dev/cam_right_wrist"
    pixel_format: "mjpeg2rgb"
    io_method: "mmap"

    # General parameters
    resolution:
      width: 848
      height: 480
      fps: 30

    camera_name: "cam_right_wrist"

    streams:
      enable_color: true
      enable_depth: false
      align_depth: false
      enable_pointcloud: false
      enable_gyro: false
      enable_accel: false

    tf:
      parent_frame: "right_wrist_link"
      child_frame: "cam_right_wrist_link"
      translation: [0.0, 0.0, 0.0]
      rotation: [0.0, 0.0, 0.0]

# -----------------------------------------------------------------------------
# Usage instructions
# -----------------------------------------------------------------------------
# 1. First-time setup (install udev rules):
#    bash src/camera/setup_cameras.sh
#
# 2. Find RealSense camera serial numbers:
#    rs-enumerate-devices | grep "Serial Number"
#
# 3. Replace wrist camera:
#    a. Update serial_number
#    b. Update the corresponding serial number in config/udev/99-teleop-cameras.rules
#    c. Re-run setup_cameras.sh
#
# 4. Docker mount:
#    docker run --device /dev/stereo_camera --device /dev/cam_left_wrist --device /dev/cam_right_wrist ...
#
# 5. Head stereo camera config see: config/stereo_head/stereo_head_config.yaml
#
# 6. Published topics:
#    /<camera_name>/color/image_raw        - RGB image
#    /<camera_name>/color/camera_info      - Camera intrinsics
#    /<camera_name>/depth/image_rect_raw   - Depth image (if enabled)
